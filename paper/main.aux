\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces FedPEFT-IMU{} architecture. Each client runs the same seven-component model {\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 172}--{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 178} on top of a frozen pretrained IMU encoder. Parameters are partitioned by role: the base weights are frozen (grey); the low-rank adapters and the projection head are federated (blue) and trained at a device-specific rank $r_k$; the input adapter, the normalization layers and the classifier stay on the device (green); class prototypes and one-shot label statistics are the only additional information that is shared (amber). The server aggregates LoRA updates exactly in delta form, re-factorizes them by a truncated SVD and folds the remainder into the frozen weights (\cref  {fig:aggregation}). New users are served without any training through the global prototypes.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{3}{\method {} architecture. Each client runs the same seven-component model \ding {172}--\ding {178} on top of a frozen pretrained IMU encoder. Parameters are partitioned by role: the base weights are frozen (grey); the low-rank adapters and the projection head are federated (blue) and trained at a device-specific rank $r_k$; the input adapter, the normalization layers and the classifier stay on the device (green); class prototypes and one-shot label statistics are the only additional information that is shared (amber). The server aggregates LoRA updates exactly in delta form, re-factorizes them by a truncated SVD and folds the remainder into the frozen weights (\cref {fig:aggregation}). New users are served without any training through the global prototypes}{figure.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][2][]3}{}{}{}}
\newlabel{eq:forward}{{4}{3}{Class prototypes \ding {177}}{equation.4}{}}
\newlabel{eq:forward@cref}{{[equation][4][]4}{[1][2][]3}{}{}{}}
